# Copy this to .env and put your key in it, or just run set-key.ps1, which
# types it straight in without it ever appearing on screen.
#
# .env is gitignored. Nothing in it leaves this machine except the requests
# reo makes to whichever model you point it at.

# --- the only line that must be filled in --------------------------------
# A free Groq key, from https://console.groq.com/keys - no card needed.
LLM_API_KEY=your-groq-key-here

# Spare keys for the same service, comma separated. A key that hits its
# per-minute limit is benched for a minute and the next one answers, which is
# the difference between reo answering and reo apologising.
# LLM_API_KEYS=

# --- everything below is optional; these are the defaults ----------------

# Where reo thinks. Any OpenAI-compatible endpoint works.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b

# Other services reo will fall back to, if you have keys for them.
# LLAMA_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=

# A model running on this machine is used when the network or the allowance
# is gone. Install ollama and pull a model with tools, and reo finds it.
# OLLAMA_HOST=http://localhost:11434

# How reo is summoned: hotkey, wake (answers to its name), or push (Enter).
# REO_MODE=hotkey
# REO_HOTKEY=<ctrl>+<alt>+r

# The window: web, tk, or off for console only.
# REO_UI=web

# Where speech becomes words. "hosted" sends it to Groq's big whisper, which
# is 0.20s against the local model's 2.65s on the same clip. "local" keeps
# every recording on this laptop and never needs the network.
# REO_HEARING=hosted

# The voice. "pyttsx3" is offline and instant. "orpheus" is Groq's, which
# sounds far better and costs about 1.15 seconds a reply - measured, because
# it speaks more slowly, not because of the network. Raise REO_SPEECH_SPEED
# if you want it back.
# REO_TTS=pyttsx3
# REO_TTS_VOICE=autumn
# REO_SPEECH_SPEED=1.15
# REO_VOICE=zira

# Names reo should expect to hear. It cannot spell what it has never been
# told, and proper nouns are most of what speech recognition gets wrong.
# REO_VOCABULARY=Reo, Hyderabad, Telugu, Chrome, Spotify, WhatsApp

# Pin the language to skip detecting it, or leave it blank to work it out
# from the first thing you say and then reuse that.
# REO_LANGUAGE=
# REO_LANGUAGES=en,te,hi

# Let reo run commands on this machine. Off by default: it is driven by
# speech that mishears, and by web pages that can be written to steer it.
# Catastrophic commands are refused outright whatever this says, and
# destructive ones have to be confirmed out loud.
# REO_ALLOW_SHELL=0

# Let reo move and click the mouse. It cannot see the screen, so it only
# ever clicks where it is told.
# REO_ALLOW_MOUSE=1

# The one folder reo may write into. On the Desktop on purpose: a file you
# cannot find is the same as no file.
# REO_WORKSPACE=
