# Free key from https://console.groq.com (no credit card needed). Fast, but the
# free tier allows 8000 tokens a minute, which one tool-heavy question can spend
# on its own - so add a second key below and reo will fall over to it.
LLM_API_KEY=your-groq-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Other keys, tried in this order when the one above hits its limit. A spent key
# is benched for a minute, then comes back. Set as many as you have.
#   https://llama.developer.meta.com     far larger per-minute budget
#   https://openrouter.ai/keys           models ending in :free
#   https://aistudio.google.com/apikey
LLAMA_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Spare keys for the service in LLM_BASE_URL, comma separated.
LLM_API_KEYS=

# Which model each of those uses, if not the sensible default:
# LLAMA_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# GEMINI_MODEL=gemini-2.0-flash

# To make one of them the first choice instead, point LLM_* straight at it. Any
# OpenAI-compatible service works, a local one included:
#   Local Ollama: LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama

# Voice: pyttsx3 (offline, instant, flat) or orpheus (expressive, needs terms
# accepted at https://console.groq.com/playground?model=canopylabs/orpheus-v1-english).
# Orpheus costs about 1.15s a reply - measured, 2.72s median against the
# offline voice's 1.91s on the same five sentences. Almost none of that is the
# network: the first audio arrives in 0.21-0.50s. It simply speaks more slowly,
# so REO_SPEECH_SPEED below is the dial if you want the time back.
REO_TTS=pyttsx3
# Orpheus voices: autumn, diana, hannah (female), austin, daniel, troy (male)
REO_TTS_VOICE=autumn
# Which Windows voice the offline backend uses. Blank for the system default.
REO_VOICE=zira
# Playback speed. 1.0 is the voice's own pace. Raising it shortens every reply
# and lifts the pitch with it, because it is played faster rather than
# resampled.
REO_SPEECH_SPEED=1.15

# How reo is summoned:
#   hotkey - a key combination starts and stops listening (default)
#   wake   - always listening, answers to its name
#   push   - press Enter in its window first
# Show the window. 0 for console only.
REO_UI=1

# Let reo run commands on this machine. Off by default on purpose: reo is driven
# by speech that mishears, and it reads web pages, where text can be written to
# steer a model. Catastrophic commands stay refused even when this is on, and
# destructive ones have to be confirmed out loud.
REO_ALLOW_SHELL=0
# Let reo move and click the mouse. It has no way to see the screen - there is
# no vision model on this account - so it can only click coordinates you give
# it, and it is told never to guess. An off-screen coordinate is refused
# rather than clamped, because the corners hold Close and Start.
REO_ALLOW_MOUSE=1
REO_MODE=hotkey
# Wake detection: "phrase" uses a model trained on the wake word and is far more
# reliable; "whisper" transcribes the room and looks for REO_WAKE_WORDS instead.
REO_WAKE_ENGINE=phrase
# A pretrained phrase (hey_jarvis, alexa, hey_mycroft, hey_rhasspy) or the path
# to a model you trained yourself. There is no pretrained "reo".
REO_WAKE_PHRASE=hey_jarvis
# pynput spelling: <ctrl> <alt> <shift> <cmd> plus a letter
REO_HOTKEY=<ctrl>+<alt>+r
# Spellings Whisper might use for the wake word. First one is what it calls itself.
REO_WAKE_WORDS=reo,rio,rayo,reyo

# Speech model. Plain names understand ~99 languages; adding .en makes them
# English-only but a little sharper. small hears an accent better than base,
# but measured on this laptop it takes about 7s against base's 2.3s on the
# same clip, so base is the default. Try small if you would rather wait.
REO_WHISPER_MODEL=base
# How wide a search through the possible transcriptions. 5 costs about 0.2s
# over 1 and is the cheapest accuracy there is. 1 is fastest.
REO_BEAM=5
# Names it keeps getting wrong. Whisper cannot spell what it has never been
# told: "Hyderabad" came back as "Bunt" and "chydra bad" before this existed.
# Add your own - people, places, apps you talk about.
REO_VOCABULARY=Reo, Claude, Hyderabad, Telangana, Telugu, Nandan, Chrome, Brave, Spotify, WhatsApp, YouTube, Notepad, VS Code
# Which languages are worth considering when REO_LANGUAGE is blank. Allowed to
# pick from all 99, Whisper read this accent as Russian and Spanish and wrote
# confident nonsense. First one wins ties.
REO_LANGUAGES=en,te,hi
# Blank detects the language each time. Set "en", "hi", "te", "es" ... to pin it.
REO_LANGUAGE=
# Where speech becomes words. "hosted" sends the recording to Groq's
# whisper-large-v3-turbo - 0.20s against the local model's 2.65s on the same
# clip, with none of its 0.66-to-2.4 second swing. "local" keeps every
# recording on this laptop and never needs the network. The local model loads
# either way: it is what answers when the network or the allowance is gone.
REO_HEARING=hosted

# A model running on this machine, used when nothing hosted will answer.
# Install ollama, pull something that supports tools, and reo finds it.
OLLAMA_HOST=http://localhost:11434

# The pause that means "done talking". 0.5 cut sentences in half: a measured
# mid-sentence pause lasted 0.8s, and reo had already stopped listening.
REO_SILENCE_SECONDS=0.9
# The same, when a key press is going to end the recording anyway, so silence
# is only a safety net.
REO_HOTKEY_SILENCE_SECONDS=1.5
# How long you may talk for. Two numbers, because the two ears cost completely
# different things: groq hears 60s in 1.44s, while the model here falls off a
# cliff between 28 and 29 seconds, where recognising a clip takes longer than
# it took to say. reo picks by whichever ear answered last.
REO_MAX_RECORD_SECONDS=45
REO_MAX_LOCAL_RECORD_SECONDS=24

# The one folder reo may write into. On the Desktop on purpose: a file you
# cannot find is the same as no file. Blank uses Desktopeo-work.
REO_WORKSPACE=

# Raise if reo "hears" background noise, lower if it misses you
REO_SILENCE_THRESHOLD=0.01
# A recording whose loudest moment is below this never reaches Whisper.
# Whisper does not return nothing for silence - it invents. Given room noise
# it produced "I've been on 30 YouTube videos again and again and again and
# again", and reo answered it. Measured here: room 0.0012, speech peaks near
# 0.06, so this sits ten times over the room and well under anything said.
REO_SPEECH_FLOOR=0.012
