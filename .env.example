# Free key from https://console.groq.com (no credit card needed)
LLM_API_KEY=your-groq-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# Any OpenAI-compatible provider works. Examples:
#   Gemini free tier: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OpenRouter free:  LLM_BASE_URL=https://openrouter.ai/api/v1   (pick a model ending in :free)
#   Local Ollama:     LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama

# Voice: pyttsx3 (offline, instant, flat) or orpheus (expressive, ~1-2s, needs
# terms accepted at https://console.groq.com/playground?model=canopylabs/orpheus-v1-english)
REO_TTS=pyttsx3
# Orpheus voices: tara, leah, jess, leo, dan, mia, zac, zoe
REO_TTS_VOICE=tara
# Which Windows voice the offline backend uses. Blank for the system default.
REO_VOICE=zira

# How reo is summoned: "wake" answers to its name with the mic always on,
# "push" waits for you to press Enter first.
REO_MODE=wake
# Spellings Whisper might use for the wake word. First one is what it calls itself.
REO_WAKE_WORDS=reo,rio,rayo,reyo

# Speech model: tiny.en (fastest), base.en (good default), small.en (most accurate)
REO_WHISPER_MODEL=base.en
# Raise if reo "hears" background noise, lower if it misses you
REO_SILENCE_THRESHOLD=0.01
